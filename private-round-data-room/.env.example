# Installation token of YOUR app installed on YOUR company (developer portal → Installations →
# Mint token). It needs these scopes, ticked on the app BEFORE you install it:
#   read:investments                                    raise totals
#   read:invite_links write:invite_links                member links (to the round's page)
#   read:investment_sessions write:investment_sessions  investment sessions (to checkout, beta)
#   read:companies (with read:public)                   only to look up the offering id below
# It is read on the server only and never reaches the browser.
WEFUNDER_INSTALL_TOKEN=

# The private round this data room is for (ofr_…). It must be a round of the company the token
# is installed on. To find it: GET https://api.wefunder.com/companies/<your co_ id> with the
# token above, then data.attributes.current_raise.offering_id (README, step 4).
WEFUNDER_OFFERING_ID=

# This data room's own origin, no trailing slash. Investment sessions send the investor back
# here, so the origin must be one your app registered as an OAuth redirect URI in the portal
# (http is accepted on localhost only). Without that, creating a session is a 422.
DATA_ROOM_URL=http://localhost:3000

# "off" hides the investment-session button and keeps member links only. Member links are
# generally available; investment sessions are in beta.
# WEFUNDER_CHECKOUT_SESSIONS=off

# ── STUB LOGIN. Replace with your real authentication before anyone but you uses this. ──
# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=
# One shared password for every fixture user in lib/users.ts. Nobody can sign in until it is set.
DEMO_PASSWORD=

# Shown in the page header.
# DATA_ROOM_COMPANY_NAME=Example Co

# Optional. Leave unset for api.wefunder.com, which routes sandbox and live by token prefix.
# WEFUNDER_API_BASE=
