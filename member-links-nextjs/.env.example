# A syndicate- or company-owned install token (at_live_…) for an app installed on the syndicate or
# company that runs the deals below. The token AND the install need read:invite_links and
# write:invite_links. A user token gets 404 from every member-link endpoint. Server-only: never
# rename it NEXT_PUBLIC_….
WEFUNDER_ACCESS_TOKEN=

# The deals the portal shows, as offering ids (ofr_…) separated by spaces or commas. An optional
# =Label sets the card title (no spaces in a label; underscores show as spaces).
# A syndicate's offerings are the SPVs it leads; a company's are all of its rounds.
# Example: WEFUNDER_OFFERING_IDS=ofr_abc123=Arc_Hockey ofr_def456
WEFUNDER_OFFERING_IDS=

# Protects the portal and the admin view (they act with the install token). Any username.
DEMO_PASSWORD=

# Only for a non-standard deployment. Leave unset for production (https://wefunder.com/api/v2).
# Member links are not available in the sandbox yet.
# WEFUNDER_API_BASE=
