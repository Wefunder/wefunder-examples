# From the Wefunder developer portal (https://wefunder.com/developers), your app's page.
# Use the pk_test_ key while building against the sandbox; the SDK picks the sandbox consent
# host from the key prefix. Note: installations and company tokens are live-only today, so
# Steps 2-4 of the guide run against real companies.
WEFUNDER_CLIENT_ID=
WEFUNDER_CLIENT_SECRET=
# Must match a redirect URI registered on the app.
WEFUNDER_REDIRECT_URI=http://localhost:3000/api/wefunder/oauth/callback
# Signing secret shown once when you create the webhook endpoint in the portal (whsec_…).
WEFUNDER_WEBHOOK_SECRET=

# Scopes each install asks for. The server grants the intersection of this and what your app
# holds; the dashboard shows what was actually granted. read:investors:pii is granted when the
# installer manages the app's organization or Wefunder has approved the app for investor PII.
WEFUNDER_INSTALL_SCOPES=read:investments read:offerings read:investors:pii

# Optional: Slack incoming webhook for the money feed. Without it the feed is dashboard-only.
# SLACK_WEBHOOK_URL=

# Protects the dashboard and mirror JSON (they show investor PII once granted). Any username.
DEMO_PASSWORD=

# Optional persistence across serverless invocations: Upstash (KV_*) or Redis (REDIS_URL).
# Without either the app keeps state in .data/store.json (local) or /tmp (Vercel, ephemeral).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=

# Only for a non-standard deployment. Leave unset for production and sandbox.
# WEFUNDER_API_BASE=
# WEFUNDER_OAUTH_BASE=
