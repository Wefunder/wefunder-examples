# Install token of your app on the company (or syndicate) that runs the offering, minted in the
# developer portal (Installations → Mint token). Needs write:investment_sessions and
# read:investment_sessions. Never ships to the phone.
WEFUNDER_INSTALL_TOKEN=

# Offerings the app lists, comma-separated (ofr_... ids). Each must belong to the noun the token
# is installed on, or the mint is refused.
WEFUNDER_OFFERING_IDS=ofr_abc123

# The app's return URL: the scheme in app.json (expo.scheme) + a path. The scheme must be on the
# app's OAuth redirect URIs in the portal, or Wefunder refuses the mint with 422 validation_error.
RETURN_URL=wefunderexample://invest/return

# Optional. Leave unset for api.wefunder.com; the proxy routes sandbox vs live by token prefix.
# WEFUNDER_API_BASE=

PORT=4181
